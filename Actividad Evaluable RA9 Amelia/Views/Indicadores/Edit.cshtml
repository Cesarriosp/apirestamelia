@model IndicadorDTO

@{
    ViewData["Title"] = "Editar Indicador";
}

<div class="row">
    <div class="col-md-12">
        <h1 class="display-5">
            <i class="bi bi-pencil-square"></i> Editar Indicador
        </h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Indicadores</a></li>
                <li class="breadcrumb-item active" aria-current="page">Editar</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row">
    <div class="col-md-8 offset-md-2">
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <strong>Error:</strong> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        
        <div class="card">
            <div class="card-header bg-warning">
                <h4 class="mb-0">Formulario de Edición</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                    
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="Tipo" class="form-label"></label>
                                <input asp-for="Tipo" class="form-control" />
                                <span asp-validation-for="Tipo" class="text-danger"></span>
                                <small class="form-text text-muted">Tipo del indicador (máx. 100 caracteres)</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="Ambito" class="form-label"></label>
                                <input asp-for="Ambito" class="form-control" />
                                <span asp-validation-for="Ambito" class="text-danger"></span>
                                <small class="form-text text-muted">Ámbito del indicador (máx. 100 caracteres)</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label asp-for="Categoria" class="form-label"></label>
                                <input asp-for="Categoria" class="form-control" />
                                <span asp-validation-for="Categoria" class="text-danger"></span>
                                <small class="form-text text-muted">Categoría del indicador (máx. 100 caracteres)</small>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                        <small class="form-text text-muted">Nombre descriptivo del indicador (máx. 100 caracteres)</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label"></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                        <small class="form-text text-muted">Descripción detallada (máx. 500 caracteres)</small>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Valor" class="form-label"></label>
                                <input asp-for="Valor" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="Valor" class="text-danger"></span>
                                <small class="form-text text-muted">Valor numérico positivo</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="Unidad" class="form-label"></label>
                                <input asp-for="Unidad" class="form-control" />
                                <span asp-validation-for="Unidad" class="text-danger"></span>
                                <small class="form-text text-muted">Unidad de medida (máx. 50 caracteres)</small>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Fecha" class="form-label"></label>
                        <input asp-for="Fecha" class="form-control" type="date" />
                        <span asp-validation-for="Fecha" class="text-danger"></span>
                        <small class="form-text text-muted">Fecha de registro del indicador</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Fuente" class="form-label"></label>
                        <input asp-for="Fuente" class="form-control" />
                        <span asp-validation-for="Fuente" class="text-danger"></span>
                        <small class="form-text text-muted">Origen de los datos (opcional, máx. 100 caracteres)</small>
                    </div>

                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-exclamation-triangle"></i> 
                        <strong>Atención:</strong> Los cambios se enviarán al API REST para actualizar el indicador.
                        Asegúrate de que todos los datos sean correctos antes de guardar.
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info">
                            <i class="bi bi-eye"></i> Ver Detalles
                        </a>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}
